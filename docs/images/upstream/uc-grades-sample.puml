' このサンプルのユースケース図（upstream/ユースケース記述.md）：教員と学生が、どのユースケースを使うか
@startuml uc-grades-sample
!include ../_common.iuml
left to right direction
skinparam actorBorderColor #555555
skinparam actorBackgroundColor white
skinparam usecaseBackgroundColor #d5f5e3
skinparam usecaseBorderColor #555555
skinparam packageStyle rectangle

actor 教員 as te
actor "学生\n（frontend/ の画面のみ）" as st

rectangle "成績管理システム" {
  usecase "学生を登録する" as u1
  usecase "成績を登録する" as u2
  usecase "成績一覧を取得する" as u3
  usecase "学生一覧を取得する" as u4 #white
  usecase "科目一覧を取得する" as u5 #white
}
te -- u1
te -- u2
te -- u3
st -- u3
u2 ..> u4 : 画面で選ぶために使う
u2 ..> u5 : 画面で選ぶために使う
u3 ..> u4 : 画面で選ぶために使う
@enduml
