<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>grades</groupId>
    <artifactId>grades-step2-jdbc</artifactId>
    <version>1.0.0</version>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JdbcClient（Spring Boot は使わない。spring-jdbc だけ） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
            <version>7.0.10</version>
        </dependency>
        <!-- PostgreSQL の JDBC ドライバ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.14</version>
        </dependency>
    </dependencies>

    <build>
        <!-- 資料のフォルダ構成（step2-jdbc/src/grades/...）に合わせる。Maven の標準は src/main/java -->
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <!-- mvn compile exec:java で起動できるようにする -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <configuration>
                    <mainClass>grades.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
