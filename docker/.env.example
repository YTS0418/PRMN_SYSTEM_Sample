# このファイルをコピーして .env を作り、パスワードを入れる（.env は Git に載せない）
#   cp .env.example .env        Windows の PowerShell では  Copy-Item .env.example .env
# パスワードは、自分で決めた、推測されにくいものにする。ここ（.env.example）には、実際の値を書かない。
POSTGRES_PASSWORD=
PGADMIN_PASSWORD=
# パソコン側の DB のポート。空なら 5432。パソコンに入れた PostgreSQL が 5432 を使っているときは 5433 などにする
DB_PORT=
